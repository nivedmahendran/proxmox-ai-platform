# Terraform variables — copy to terraform.tfvars and fill in.
proxmox_endpoint   = "https://10.10.10.113:8006"
proxmox_username   = "root@pam!opencode-mcp"
proxmox_token      = "REPLACE_WITH_TOKEN_SECRET"
proxmox_insecure   = true

# Ubuntu 24.04 cloud-init template VMID (find with: qm list)
vm_template_id      = 9000

ct_root_password    = "REPLACE_WITH_CT_ROOT_PASSWORD"

ssh_public_keys = [
  "ssh-rsa AAAA...REPLACE... nived"
]
